<?xml version="1.0" encoding="utf-8"?>     
<odoo>
    <data> 
        <!-- vista de lista (list) Punto 40 -->   
        <record id="estate_property_offer_list_view" model="ir.ui.view">
            <field name="name">estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>

            <field name="arch" type="xml">
                <list> <!-- Punto 8 unidad 2 saco editable="top" -->
                    <field name="price"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="validity"></field>
                    <field name="date_deadline"></field>
                    <field name="property_type_id"></field>
                    <!-- Botón para aceptar oferta -->
                    <button name="action_accept_offer" 
                            type="object" 
                            string="Aceptar" 
                            icon="fa-check"
                            invisible="status in ['accepted', 'refused']"/>
                </list>
            </field>
        </record>
                <!-- Vista Form -->
        <record id="estate_property_offer_view_form" model="ir.ui.view">
            <field name="name">estate.property.offer.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="Oferta">
                    <sheet>
                        <group>
                            <group>
                                <field name="property_id"/>
                                <field name="property_type_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="price"/>
                                <field name="validity"/>
                                <field name="date_deadline"/>
                                <field name="status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Acción de ventana -->
        <record id="estate_property_offer_action" model="ir.actions.act_window">
            <field name="name">Ofertas</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'property_type_id'}</field>
        </record>

        <menuitem
            id="estate_property_offer_menu"
            name="Ofertas"
            action="estate_property_offer_action"
            parent="menu_estate_advertisements"
            sequence="20"/>
        </data>
</odoo>